{
  "controller_type": "vive_controller",
  "description": "SHMCD-VR default (Vive wands; trackpad acts as stick)",
  "name": "SHMCD-VR default",
  "bindings": {
    "/actions/shmcd": {
      "sources": [
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/shmcd/in/stick_l"
            },
            "click": {
              "output": "/actions/shmcd/in/stickclick_l"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/shmcd/in/trigger_l"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/shmcd/in/grip_l"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/shmcd/in/stick_r"
            },
            "click": {
              "output": "/actions/shmcd/in/stickclick_r"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/shmcd/in/trigger_r"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/shmcd/in/grip_r"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/shmcd/in/b_l"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/shmcd/in/b_r"
            }
          }
        }
      ],
      "poses": [
        { "output": "/actions/shmcd/in/pose_l", "path": "/user/hand/left/pose/tip" },
        { "output": "/actions/shmcd/in/pose_r", "path": "/user/hand/right/pose/tip" }
      ],
      "haptics": [
        {
          "output": "/actions/shmcd/out/haptic_l",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/shmcd/out/haptic_r",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}